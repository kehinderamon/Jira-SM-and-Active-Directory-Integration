# Copy this file to .env and fill in your real values.
# NEVER commit your actual .env file — it's already excluded in .gitignore.

# ---- Jira Service Management ----
JIRA_SITE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_PROJECT_KEY=ITSD

# ---- Active Directory ----
# Hostname or IP of a domain controller (use the LDAPS/636 port hostname,
# not a plain-LDAP-only one — setting passwords requires an encrypted connection).
AD_SERVER=dc01.lab.local

# Your AD domain name (also used to build userPrincipalName as user@domain)
AD_DOMAIN=lab.local

# A service account with permission to create/disable users and edit
# group membership. In a real environment, use a dedicated service
# account with the minimum delegated permissions needed — never a
# personal Domain Admin account.
AD_BIND_USER=svc_provisioning
AD_BIND_PASSWORD=your_service_account_password_here

# The base Distinguished Name of your domain, e.g. DC=lab,DC=local
AD_BASE_DN=DC=lab,DC=local

# The OU new user accounts should be created in, e.g.
# OU=Employees,OU=Users,DC=lab,DC=local  (defaults to AD_BASE_DN if not set)
AD_USERS_OU=OU=Users,DC=lab,DC=local
